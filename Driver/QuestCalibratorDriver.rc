// Version resource for the SteamVR driver DLL. Support needs a way to ask which
// build a user is running, and the DLL lives inside the SteamVR folder where the
// only identifying information is the file itself.
#include "windows.h"
#include "..\common\Version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION QUESTCAL_VERSION_MAJOR,QUESTCAL_VERSION_MINOR,QUESTCAL_VERSION_PATCH,0
 PRODUCTVERSION QUESTCAL_VERSION_MAJOR,QUESTCAL_VERSION_MINOR,QUESTCAL_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VividNightmare"
            VALUE "FileDescription", "QuestCalibrator SteamVR driver"
            VALUE "FileVersion", QUESTCAL_VERSION_STRING
            VALUE "InternalName", "driver_01questcalibrator"
            VALUE "LegalCopyright", "Copyright (c) 2026 VividNightmare"
            VALUE "OriginalFilename", "driver_01questcalibrator.dll"
            VALUE "ProductName", "QuestCalibrator"
            VALUE "ProductVersion", QUESTCAL_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
